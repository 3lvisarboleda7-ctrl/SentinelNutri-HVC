      "id": "tool-6-notificar",
      "name": "Tool 6: notificar",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [
        1020,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json || {};\nlet parsed = {};\nif (typeof raw.output === 'string') {\n  const m = raw.output.match(/\\{[\\s\\S]*\\}/);\n  if (m) {\n    try { parsed = JSON.parse(m[0]); } catch (e) { parsed = {}; }\n  }\n} else if (typeof raw.dci_proyectada_pct === 'number') {\n  parsed = { ...raw };\n}\n\nconst needsFallback = !parsed.ubigeo || !parsed.distrito || typeof parsed.dci_proyectada_pct !== 'number' || !parsed.id_alerta;\nif (needsFallback) {\n  const predRes = await this.helpers.httpRequest({\n    method: 'POST',\n    url: 'http://api_engine:8000/predict',\n    body: { anio_corte: 2024 },\n    json: true,\n  });\n  const rows = (predRes.distritos_criticos_s5 && predRes.distritos_criticos_s5.length) ? predRes.distritos_criticos_s5 : (predRes.predicciones_distritales || []);\n  rows.sort((a, b) => Number(b.dci_proyectada_pct || 0) - Number(a.dci_proyectada_pct || 0));\n  const top = rows[0] || { ubigeo: '090106', distrito: 'Huachocolpa', provincia: 'Huancavelica', dci_proyectada_pct: 25.65 };\n  const infRes = await this.helpers.httpRequest({\n    method: 'POST',\n    url: 'http://api_engine:8000/tools/redactar_informe',\n    body: { district_context: top, prefer_provider: 'gemini' },\n    json: true,\n  });\n  const inf = infRes.informe || {};\n  const notRes = await this.helpers.httpRequest({\n    method: 'POST',\n    url: 'http://api_engine:8000/tools/notificar',\n    body: { report_payload: inf },\n    json: true,\n  });\n  parsed = {\n    ubigeo: inf.ubigeo || top.ubigeo,\n    distrito: inf.distrito || top.distrito,\n    provincia: inf.provincia || top.provincia,\n    dci_proyectada_pct: Number(inf.dci_proyectada_pct ?? top.dci_proyectada_pct ?? 25.0),\n    id_alerta: Number(notRes.id_alerta || 1),\n    canal_destino: inf.canal_destino || 'S5_ALGEDONICO',\n    sintesis_narrativa_s4: inf.sintesis_narrativa_s4 || (typeof raw.output === 'string' ? raw.output.slice(0, 400) : 'Síntesis S4 generada.'),\n  };\n}\nreturn [{ json: parsed }];"
      },
