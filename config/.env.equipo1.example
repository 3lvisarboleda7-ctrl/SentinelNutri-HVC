# ============================================================================
# CONFIGURACIÓN PARA EQUIPO 1: Estación de Desarrollo (Windows 11 Pro · i7-1355U)
# ============================================================================
APP_ENV=development
NODE_ROLE=EQUIPO_1_DEV_WORKSTATION

# Conexión por Red Local (LAN) hacia el Equipo 2 (o SQLite local si se corre desconectado)
EQUIPO2_LAN_IP=192.168.1.50
DATABASE_URL=sqlite:///./data/sentinelnutri_dev.db
# Para conectar al PostgreSQL del Equipo 2 por LAN, descomentar:
# DATABASE_URL=postgresql+psycopg2://sentinel_user:sentinel_pass_2026@192.168.1.50:5432/sentinelnutri_hvc

# Rutas locales en Equipo 1 para pruebas y exportación a Google Colab
RAW_DATA_DIR=./data/raw
MODELS_DIR=./data/models
SHARED_DIRESA_DIR=./data/diresa_ley29733

# Reglas Fijas Cibernéticas (MSV - Fuera del alcance del LLM)
ALGEDONIC_DCI_THRESHOLD=0.25
REQUIRE_HUMAN_APPROVAL_S3=true
PRIVACY_ENFORCE_AGGREGATES_ONLY=true

# Extracción Responsable
ACADEMIC_USER_AGENT="SentinelNutri-HVC/1.0 (Proyecto Academico FIIS-UNI; MSV-S4; mailto:elvis.arboleda@uni.pe)"
SCRAPER_RATE_LIMIT_SECONDS=2.0
RESPECT_ROBOTS_TXT=true

# Proveedores LLM (Gemini Free Tier como principal, Ollama GTX 1050 en Equipo 2 como respaldo)
GEMINI_API_KEY=tu_api_key_gratuita_google_ai_studio
GEMINI_MODEL=gemini-2.0-flash
OLLAMA_BASE_URL=http://192.168.1.50:11434
OLLAMA_MODEL=llama3.2

