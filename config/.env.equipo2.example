# ============================================================================
# CONFIGURACIÓN PARA EQUIPO 2: Servidor Local (Windows 10 · i7-7700HQ · GTX 1050 4GB)
# SSD (447 GB): C:\SentinelNutri  |  HDD (1 TB): D:\SentinelNutri
# ============================================================================
APP_ENV=production
NODE_ROLE=EQUIPO_2_LOCAL_SERVER

# Rutas Físicas en Equipo 2 (Separación SSD vs HDD de 1 TB)
SSD_POSTGRES_DATA=C:/SentinelNutri/ssd/postgres_data
SSD_N8N_DATA=C:/SentinelNutri/ssd/n8n_data
HDD_RAW_DATA=D:/SentinelNutri/hdd/raw
HDD_MODELS_DIR=D:/SentinelNutri/hdd/models
HDD_BACKUPS_DIR=D:/SentinelNutri/hdd/backups
HDD_OLLAMA_MODELS=D:/SentinelNutri/hdd/ollama_models
HDD_DIRESA_SHARED=D:/SentinelNutri/hdd/diresa_convenio_ley29733

# Base de Datos PostgreSQL (Alojada en SSD del Equipo 2)
POSTGRES_USER=sentinel_user
POSTGRES_PASSWORD=sentinel_pass_2026
POSTGRES_DB=sentinelnutri_hvc
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://sentinel_user:sentinel_pass_2026@postgres:5432/sentinelnutri_hvc

# Reglas Fijas Cibernéticas (MSV)
ALGEDONIC_DCI_THRESHOLD=0.25
REQUIRE_HUMAN_APPROVAL_S3=true
PRIVACY_ENFORCE_AGGREGATES_ONLY=true

# Extracción Responsable
ACADEMIC_USER_AGENT="SentinelNutri-HVC/1.0 (Proyecto Academico FIIS-UNI; MSV-S4; mailto:elvis.arboleda@uni.pe)"
SCRAPER_RATE_LIMIT_SECONDS=2.5
RESPECT_ROBOTS_TXT=true

# Proveedores LLM (Gemini Free Tier + Ollama Local en GPU NVIDIA GTX 1050 4GB)
GEMINI_API_KEY=tu_api_key_gratuita_google_ai_studio
GEMINI_MODEL=gemini-flash-lite-latest
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2

# Canales MSV: Telegram Bot API (S5 Algedónico, HITL y Fallos de Scraper) y Gmail SMTP
TELEGRAM_BOT_TOKEN=123456789:ABCDEF_tu_token_botfather
TELEGRAM_CHAT_ID_S5_CONSEJO=-1001111111111
TELEGRAM_CHAT_ID_S3_APROBACION=-1002222222222
TELEGRAM_CHAT_ID_ADMIN_TECH=-1003333333333
GMAIL_USER=sentinelnutri.hvc@gmail.com
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx
GMAIL_RECIPIENT_S5=consejo.regional@regionhuancavelica.gob.pe
GMAIL_RECIPIENT_S3=grds@regionhuancavelica.gob.pe

# Cloudflare Tunnel (Permite aprobar desde el celular sin abrir puertos del router en Windows 10)
CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoi...tu_token_cloudflare_zero_trust
N8N_PUBLIC_WEBHOOK_URL=https://n8n-sentinelnutri.tudominio.cfargotunnel.com/

